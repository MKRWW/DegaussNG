<Window x:Class="DegaussNG.HotkeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change hotkey"
        Width="340"
        Height="150"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow">
    <Grid Margin="12">
        <StackPanel>
            <TextBlock Text="Press a key combination: at least one modifier and one key."
                       TextWrapping="Wrap" />
            <TextBox x:Name="HotkeyBox"
                     Margin="0,10"
                     IsReadOnly="True" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK"
                        IsDefault="True"
                        MinWidth="70"
                        Click="OnOkClick" />
                <Button Content="Cancel"
                        IsCancel="True"
                        MinWidth="70"
                        Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
